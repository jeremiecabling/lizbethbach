# Optional overrides for the launchd run. Copy to macos/env.sh to use.
# Defaults are fine for the Mac path; you usually don't need this file.

# Where the schedule + ledger live (relative to the imessage-sender/ dir):
# export SCHEDULE_CSV="schedule.csv"
# export SENT_LEDGER="sent-ledger.json"

# Timezone of the send_at_local column and the grace window:
# export SCHEDULE_TZ="America/New_York"
# export GRACE_WINDOW_HOURS="2"

# Source/transport (defaults: csv + imessage). Switch to the cloud path only if you
# decide to use Google Sheets + LoopMessage instead of this Mac:
# export SOURCE="sheet"
# export TRANSPORT="loop"
